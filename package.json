{
  "name": "redeye-remover",
  "version": "0.5.2",
  "description": "Simple red-eye remover: web, desktop and phone (PWA)",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "dev": "node scripts/copy-mediapipe.mjs && vite",
    "build": "node scripts/copy-mediapipe.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "icons": "tsx tools/make-icons.ts",
    "debug:blobs": "tsx tools/blobsheet.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emanuelemessina/redeye-remover.git"
  },
  "keywords": [],
  "author": "Emanuele Messina",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/emanuelemessina/redeye-remover/issues"
  },
  "homepage": "https://github.com/emanuelemessina/redeye-remover#readme",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "jpeg-js": "^0.4.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2"
  },
  "private": true
